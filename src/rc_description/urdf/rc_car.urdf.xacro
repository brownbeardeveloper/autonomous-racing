<?xml version="1.0"?>

<!-- The Traxxas Slash as measured, laid out like the simulator's racecar model
     (f1tenth_gym_ros/launch/ego_racecar.xacro). base_link is the rear axle.
     The laser mount is not cosmetic: rf2o and the particle filter read it
     from TF to turn lidar motion into base_link motion. The rest is visual:
     no collisions, no inertias.

     Two things differ from the sim model, and the stack needs both:
       - `prefix` is an argument, so the link names follow the namespace.
       - the lidar link is `laser` and `rear_axle` exists: scans carry
         frame_id <prefix>laser, and pure pursuit tracks <prefix>rear_axle. -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="racecar">

  <xacro:arg name="prefix" default=""/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <!-- Measured on the car. -->
  <xacro:property name="wheelbase" value="0.33" />
  <xacro:property name="length" value="0.56" />
  <xacro:property name="width" value="0.30" />           <!-- tire to tire -->
  <xacro:property name="front_overhang" value="0.095" /> <!-- front axle to front bumper -->
  <xacro:property name="laser_to_front" value="0.14" />  <!-- laser to front bumper -->
  <xacro:property name="wheel_radius" value="0.0475" />

  <!-- Not measured: chassis height and tire width are visual only. -->
  <xacro:property name="height" value="0.1" />
  <xacro:property name="ground_offset" value="0.04" />
  <xacro:property name="wheel_length" value="0.0381" />
  <xacro:property name="laser_height" value="0.05" />
  <xacro:property name="laser_radius" value="0.026" />

  <material name="black">
    <color rgba="0.2 0.2 0.2 1."/>
  </material>

  <material name="blue">
    <color rgba="0.3 0.57 1. 1."/>
  </material>

  <link name="${prefix}base_link">
    <visual>
      <origin xyz="${wheelbase+front_overhang-length/2} 0 ${ground_offset+height/2}"/>
      <geometry>
        <box size="${length} ${width-2*wheel_length} ${height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- The frame pure pursuit steers: its bicycle model is only valid at the
       rear axle, which is where base_link already is. -->
  <link name="${prefix}rear_axle"/>

  <joint name="base_to_rear_axle" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}rear_axle"/>
  </joint>

  <joint name="base_to_laser" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}laser"/>
    <origin xyz="${wheelbase+front_overhang-laser_to_front} 0 ${ground_offset+height+(laser_height/2)}"/>
  </joint>

  <link name="${prefix}laser">
    <visual>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="base_to_back_left_wheel" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}back_left_wheel"/>
    <origin xyz="0 ${(width-wheel_length)/2} ${wheel_radius}"/>
  </joint>

  <link name="${prefix}back_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
      <material name="black"/>
      <origin rpy="${pi/2} 0 0"/>
    </visual>
  </link>

  <joint name="base_to_back_right_wheel" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}back_right_wheel"/>
    <origin xyz="0 ${-(width-wheel_length)/2} ${wheel_radius}"/>
  </joint>

  <link name="${prefix}back_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
      <material name="black"/>
      <origin rpy="${pi/2} 0 0"/>
    </visual>
  </link>

  <joint name="base_to_front_left_hinge" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}front_left_hinge"/>
    <origin xyz="${wheelbase} ${(width-wheel_length)/2} ${wheel_radius}"/>
  </joint>

  <link name="${prefix}front_left_hinge"/>

  <joint name="front_left_hinge_to_wheel" type="continuous">
    <parent link="${prefix}front_left_hinge"/>
    <child link="${prefix}front_left_wheel"/>
  </joint>

  <link name="${prefix}front_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
      <material name="black"/>
      <origin rpy="${pi/2} 0 0"/>
    </visual>
  </link>

  <joint name="base_to_front_right_hinge" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}front_right_hinge"/>
    <origin xyz="${wheelbase} ${-(width-wheel_length)/2} ${wheel_radius}"/>
  </joint>

  <link name="${prefix}front_right_hinge"/>

  <joint name="front_right_hinge_to_wheel" type="continuous">
    <parent link="${prefix}front_right_hinge"/>
    <child link="${prefix}front_right_wheel"/>
  </joint>

  <link name="${prefix}front_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
      <material name="black"/>
      <origin rpy="${pi/2} 0 0"/>
    </visual>
  </link>

</robot>
